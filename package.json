{
  "name": "videotrace",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run build:agent && node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p tsconfig.agent.json --noEmit",
    "build:agent": "tsc -p tsconfig.agent.json",
    "agent:dev": "npm run build:agent && node dist/agent/server.js",
    "test:browser": "node scripts/browser-check.mjs",
    "package": "npm run typecheck && npm run build:agent && npm run check && python3 scripts/package.py"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/sdk-trace-base": "2.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
