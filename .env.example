# 本地 Agent 服务使用；不要提交真实密钥
# 主分析模型使用 PIAI 的 OpenAI-compatible Chat Completions
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-model-api-key
# 默认请求推理；具体支持由模型服务决定。
# AI_REASONING=false
# 换模型服务时，请一起替换 AI_BASE_URL 和 AI_API_KEY。
# 音频转写仍单独使用百炼
BAILIAN_API_KEY=your-bailian-key
BAILIAN_MODEL=qwen-audio-3.1-asr-flash-filetrans

# 联网搜索：填入 Tavily 密钥后，Agent 默认可调用 web_search。
TAVILY_API_KEY=

# 可选：本地 Langfuse 项目的 API 密钥，两项都填后启用追踪。
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
